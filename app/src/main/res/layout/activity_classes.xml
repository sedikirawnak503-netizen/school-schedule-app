<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إدارة الفصول"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etClassName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="اسم الفصل"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="#ffffff"
        android:elevation="2dp" />

    <EditText
        android:id="@+id/etClassLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="المستوى (مثل: الأول الثانوي)"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="#ffffff"
        android:elevation="2dp" />

    <EditText
        android:id="@+id/etStudentCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="عدد الطلاب"
        android:inputType="number"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:background="#ffffff"
        android:elevation="2dp" />

    <Button
        android:id="@+id/btnAddClass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إضافة فصل"
        android:textColor="#fff"
        android:background="#4CAF50"
        android:layout_marginBottom="16dp"
        android:textSize="16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewClasses"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>