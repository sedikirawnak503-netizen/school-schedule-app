<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إدارة المواد"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etSubjectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="اسم المادة"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="#ffffff"
        android:elevation="2dp" />

    <EditText
        android:id="@+id/etSubjectCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="كود المادة"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="#ffffff"
        android:elevation="2dp" />

    <EditText
        android:id="@+id/etSubjectDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="وصف المادة"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:background="#ffffff"
        android:elevation="2dp"
        android:minLines="3" />

    <Button
        android:id="@+id/btnAddSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إضافة مادة"
        android:textColor="#fff"
        android:background="#4CAF50"
        android:layout_marginBottom="16dp"
        android:textSize="16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSubjects"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>